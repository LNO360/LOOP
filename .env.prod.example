# ── LNO OS — Production Environment ───────────────────────────
# Copy to .env.prod, fill every value, never commit .env.prod to git.
# Used by docker-compose.prod.yml (via ./deploy.sh).
#
# IMPORTANT — to keep existing logins and saved integrations working after
# migrating from local, reuse these EXACT values from your local .env:
#   BETTER_AUTH_SECRET, INTEGRATION_ENCRYPTION_KEY

# ── Domain ─────────────────────────────────────────────────────
DOMAIN=loop.lno.co.in

# ── Database ───────────────────────────────────────────────────
POSTGRES_USER=lno
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=lno_os

# ── Redis ──────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Auth secret (reuse local value so existing sessions survive) ─
# Generate (only if starting fresh): python3 -c "import secrets; print(secrets.token_hex(32))"
BETTER_AUTH_SECRET=CHANGE_ME_reuse_local_value
FRONTEND_URL=https://loop.lno.co.in

# ── MinIO (file / document storage) ───────────────────────────
MINIO_ROOT_USER=lno_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password
S3_BUCKET=lno-files

# ── Next.js public vars (baked into the JS bundle at BUILD time) ─
# NO trailing path: the frontend appends "/api/v1" and "/ws/{id}" itself.
NEXT_PUBLIC_API_URL=https://loop.lno.co.in
NEXT_PUBLIC_WS_URL=wss://loop.lno.co.in

# ── AI / OpenRouter ────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-CHANGE_ME
# Second OpenRouter account — Hermes uses when account 1 hits rate limits (separate free quota)
OPENROUTER_API_KEY_SECONDARY=sk-or-CHANGE_ME_SECOND_ACCOUNT
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_AGENT_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_FALLBACK_MODEL=openrouter/free
OPENROUTER_CRON_MODEL=openrouter/free
# Hermes Telegram/gateway fallback chain (owl-alpha → free → Groq) is in hermes/config.yaml
GROQ_API_KEY=your_groq_api_key_here
# Groq fallback chain (Hermes): openai/gpt-oss-120b first — see hermes/config.yaml
# Semantic memory search — reuses OPENROUTER_API_KEY (OpenRouter /embeddings).
# Set EMBEDDING_ENABLED=false to disable (search falls back to keyword-only).
EMBEDDING_ENABLED=true
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536
HERMES_SERVICE_TOKEN=CHANGE_ME_token_hex_32

# ── Integration token encryption (REUSE local value — see note above) ─
# Generate (only if starting fresh): python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENCRYPTION_KEY=CHANGE_ME_reuse_local_value

# ── Google OAuth (update callback in Google Cloud Console too) ─
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://loop.lno.co.in/api/v1/integrations/google/callback

# ── GitHub OAuth + App (update callback in GitHub settings too) ─
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://loop.lno.co.in/api/v1/integrations/github/callback
GITHUB_DEFAULT_ORG=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_NAME=
# Private key PEM is uploaded to /root/.lno-secrets/ on the server (mounted at /run/secrets)
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app.private-key.pem

# ── Telegram (@LNO_Founders_office_bot) ───────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_BOT_NAME=your_telegram_bot_name

# Workspace ID for Telegram gateway and cron sessions.
# Set this to avoid lno_list_workspaces discovery call on every session.
# Find your workspace UUID in LNO OS → Settings → Workspace.
DEFAULT_WORKSPACE_ID=

# ── lno.co.in blog CMS (Supabase — SEO Analyst Content tab + lno_blog_* tools) ─
# From Supabase project for the marketing site: Settings → API → URL + service_role key
LNO_SITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
LNO_SITE_SUPABASE_SERVICE_KEY=

# lno.co.in — redeploy after Hermes publishes a blog post (Vercel Deploy Hook URL)
LNO_SITE_VERCEL_DEPLOY_HOOK=
# GitHub repo for TanStack site (owner/repo) — Hermes can commit .blog-slugs.json before deploy
LNO_SITE_GITHUB_REPO=your-org/your-site-repo
LNO_SITE_GITHUB_BRANCH=main
# Optional PAT with repo scope if you want slug sync without workspace GitHub OAuth
LNO_SITE_GITHUB_PAT=
LNO_SITE_AUTO_DEPLOY_ON_PUBLISH=true

# ── Optional ───────────────────────────────────────────────────
BRAVE_SEARCH_API_KEY=
AGENTCALL_API_KEY=
