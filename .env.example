# Database
DATABASE_URL=postgresql+asyncpg://lno:lno_dev@localhost:5432/lno_os

# Redis
REDIS_URL=redis://localhost:6379

# Auth (Better Auth shared secret — must match between Next.js and FastAPI)
BETTER_AUTH_SECRET=change_me_to_32_char_random_string_here

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=lno_minio
S3_SECRET_KEY=lno_minio_dev
S3_BUCKET=lno-files

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Hermes MCP bridge — shared secret between FastAPI MCP server and Hermes sidecar
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
HERMES_SERVICE_TOKEN=dev-token-change-in-production

# Daily digest scheduler — comma-separated workspace UUIDs only (empty = disabled)
# LNO Technologies production:
DIGEST_WORKSPACE_IDS=

# Background/cron API routes (digest agent, memory extraction) — free model only
OPENROUTER_CRON_MODEL=openrouter/free

# Second OpenRouter key — Hermes fallback + crons (hermes/config.yaml)
OPENROUTER_API_KEY_SECONDARY=

# Groq — Hermes fallback after both OpenRouter accounts (hermes/config.yaml)
GROQ_API_KEY=
